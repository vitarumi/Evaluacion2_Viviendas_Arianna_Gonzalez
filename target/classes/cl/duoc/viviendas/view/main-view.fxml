<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.viviendas.controller.ViviendaController">
   <children>
      <Label layoutX="28.0" layoutY="16.0" text="Registro de viviendas">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label layoutX="29.0" layoutY="61.0" text="Tipo:" />
      <Label layoutX="29.0" layoutY="99.0" text="Código:" />
      <Label layoutX="31.0" layoutY="137.0" text="Superficie (m²):" />
      <Label layoutX="31.0" layoutY="176.0" text="Habitación:" />
      <TextField fx:id="txtCodigo" layoutX="131.0" layoutY="95.0" prefHeight="25.0" prefWidth="144.0" />
      <TextField fx:id="txtHabitaciones" layoutX="131.0" layoutY="172.0" prefHeight="25.0" prefWidth="144.0" />
      <TextField fx:id="txtSuperficie" layoutX="131.0" layoutY="133.0" prefHeight="25.0" prefWidth="144.0" />
      <TitledPane animated="false" layoutX="28.0" layoutY="208.0" prefHeight="112.0" prefWidth="248.0" text="Datos del departament">
        <content>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="64.0" prefWidth="246.0">
               <children>
                  <CheckBox fx:id="chkGastoComun" layoutX="14.0" layoutY="38.0" mnemonicParsing="false" text="Gasto común al día" />
                  <CheckBox fx:id="chkEstacionamiento" layoutX="14.0" layoutY="62.0" mnemonicParsing="false" text="Estacionamiento asignado" />
                  <Label layoutX="14.0" layoutY="11.0" text="Piso:" />
                  <TextField fx:id="txtPiso" layoutX="46.0" layoutY="7.0" prefHeight="25.0" prefWidth="126.0" />
               </children>
            </AnchorPane>
        </content>
      </TitledPane>
      <TitledPane animated="false" layoutX="30.0" layoutY="331.0" prefHeight="71.0" prefWidth="248.0" text="Datos de la casa">
        <content>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
               <children>
                  <CheckBox fx:id="chkPatio" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" text="Cuenta con patio" />
               </children>
            </AnchorPane>
        </content>
      </TitledPane>
      <Button layoutX="214.0" layoutY="409.0" mnemonicParsing="false" onAction="#registrarVivienda" text="Registrar" />
      <Label fx:id="lblMensaje" layoutX="31.0" layoutY="414.0" prefHeight="17.0" prefWidth="175.0" />
      <TableView fx:id="tablaViviendas" layoutX="316.0" layoutY="57.0" prefHeight="344.0" prefWidth="554.0">
        <columns>
          <TableColumn fx:id="colTipo" prefWidth="99.0" text="Tipo" />
          <TableColumn fx:id="colCodigo" prefWidth="109.0" text="Codígo" />
            <TableColumn fx:id="colSuperficie" prefWidth="119.0" text="Superficie (m2)" />
            <TableColumn fx:id="colHabitaciones" prefWidth="107.0" text="Habitaciones" />
            <TableColumn fx:id="colCosto" prefWidth="119.0" text="Costo arriendo" />
        </columns>
      </TableView>
      <Button layoutX="316.0" layoutY="410.0" mnemonicParsing="false" onAction="#eliminarVivienda" text="Eliminar" />
      <ComboBox fx:id="cmbTipo" layoutX="132.0" layoutY="57.0" onAction="#alSeleccionarTipo" prefHeight="25.0" prefWidth="144.0" />
   </children>
</AnchorPane>
